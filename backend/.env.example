# Server configuration port (default: 5001 or assigned by Render)
PORT=5001

# GitHub Personal Access Token (for live data queries).
# Leave blank or unconfigured to automatically use high-fidelity Demo Mode.
GITHUB_TOKEN=your_personal_access_token_here

# Google Gemini API key (free tier) for the AI Code Analyzer
GEMINI_API_KEY=your_gemini_api_key_here

# JWT and Session secret strings for user auth
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# Frontend URL (e.g. https://your-app.vercel.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Backend URL (e.g. https://your-backend.onrender.com or http://localhost:5001)
BACKEND_URL=http://localhost:5001

# MongoDB Connection URI (Optional: Leave empty for stateless demo mode)
MONGODB_URI=

# GitHub OAuth credentials (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email digest configuration (Optional)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=


